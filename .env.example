# App
# URL oficial do Meu Rim (usada em convites, QR Code, compartilhamento e links ao paciente).
# Em produção use: https://meurin.vercel.app
NEXT_PUBLIC_APP_URL=https://meurin.vercel.app

# Supabase (primeiro passo recomendado)
# Quando preencher estas 2 variáveis, o app passa a usar Postgres/Supabase
# em vez de data/db.json.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Session (troque em produção)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# E-mail real (Resend). Com RESEND_API_KEY preenchido, os e-mails são enviados
# de verdade; sem ele, ficam apenas no log (modo demonstração).
# RESEND_API_KEY=
# EMAIL_FROM=Meu Rim <consultas@seu-dominio.com.br>

# Pagamento real (Mercado Pago Checkout Pro). Com MERCADOPAGO_ACCESS_TOKEN
# preenchido, o checkout é real e a confirmação vem pelo webhook; sem ele, o
# pagamento é simulado (liberação imediata).
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Banco alternativo (se usar outro Postgres fora do Supabase)
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Notificações push (Web Push / PWA). Gere um par de chaves VAPID com:
#   npx web-push generate-vapid-keys
# A chave PÚBLICA pode ficar exposta; a PRIVADA é secreta (só no servidor).
# Sem estas variáveis, o app continua funcionando: as notificações ficam
# apenas na central in-app (sino), sem envio push ao aparelho.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Também exponha a pública para o cliente (uma das duas basta; use as duas por segurança):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Assunto de contato (mailto: ou https:) exigido pelo padrão Web Push:
# VAPID_SUBJECT=mailto:contato@seu-dominio.com.br

# Cron dos lembretes (24h/2h). A Vercel Cron chama /api/cron/reminders.
# Defina um segredo para proteger o endpoint (a Vercel envia Authorization: Bearer <CRON_SECRET>).
# CRON_SECRET=troque-por-uma-string-longa-e-aleatoria
